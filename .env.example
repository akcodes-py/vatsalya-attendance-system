# ─── Django Backend Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in your values.
# On AWS (ECS/EB), set these as environment variables in the task/app config.

# REQUIRED: Generate a strong secret key (e.g. python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=your-strong-secret-key-here

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hostnames (your EC2/ECS domain or Elastic IP)
# e.g. myapp.ap-south-1.elasticbeanstalk.com,api.yourdomain.com
ALLOWED_HOSTS=*

# ─── Database ─────────────────────────────────────────────────────────────────
# AWS RDS PostgreSQL connection string
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres:password@your-rds-host.amazonaws.com:5432/vatsalya_attendance

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# e.g. https://vatsalya.vercel.app,https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app

# ─── AWS S3 Media Storage (for user photos) ───────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION_NAME=ap-south-1

# ─── Frontend Environment Variables ───────────────────────────────────────────
# The URL of your deployed Django backend API
VITE_API_BASE_URL=https://your-backend-domain.com
